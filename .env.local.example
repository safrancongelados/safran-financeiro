# Postgres do projeto "financas" na Supabase da Safran: use o "Transaction
# pooler" (porta 6543, botão Connect). Na Vercel, o Session pooler (5432)
# estoura o limite de 15 clientes; a conexão direta é só IPv6.
# Caractere especial da senha vai codificado: "#" vira "%23".
DATABASE_URL="postgresql://postgres.<projeto>:<senha>@aws-0-us-east-2.pooler.supabase.com:6543/postgres"

# Assina o cookie de sessão. Qualquer string longa e aleatória.
SESSION_SECRET=""

# Pluggy (aplicação da Safran em dashboard.pluggy.ai). Só no servidor.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Protege /api/cron/pluggy. A Vercel envia esse valor sozinha no header
# Authorization quando a variável existe no projeto. Sem ela, o cron é recusado.
CRON_SECRET=""

# Protege /api/webhooks/pluggy. Vai junto na URL de webhook de cada conexão
# feita pelo widget. Sem ela, o sistema funciona só com o cron e o botão.
PLUGGY_WEBHOOK_SECRET=""

# Primeiro acesso, criado no deploy se o e-mail ainda não existe (scripts/usuario-inicial.mjs).
# Senha com "#" vai entre aspas. Pode apagar depois do primeiro login.
USUARIO_INICIAL_EMAIL=""
USUARIO_INICIAL_SENHA=""
USUARIO_INICIAL_NOME="Safran"

# Cardápio Web (a loja virtual). Só leitura, só no servidor. Os pedidos
# repartem a receita da DRE por linha de produto — o extrato não sabe o que
# foi vendido. Token e endereço da API: docs.cardapioweb.com (Referência da
# API); a loja é o UUID que a API devolve para a Safran Congelados.
CARDAPIO_WEB_API_URL=""
CARDAPIO_WEB_TOKEN=""
CARDAPIO_WEB_MERCHANT_UUID=""
# Header que leva o token. Padrão "Authorization" (manda "Bearer <token>");
# para API Key legado, troque pelo nome do header que a documentação indicar.
# CARDAPIO_WEB_TOKEN_HEADER="Authorization"
